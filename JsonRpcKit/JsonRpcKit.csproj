<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>JsonRpcKit</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>JSON-RPC 2.0 over WebSocket for ASP.NET Core: a dispatcher that routes to [RpcMethod]-attributed targets, with per-connection scopes, batching and typed errors.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.2.2" />
  </ItemGroup>
</Project>
